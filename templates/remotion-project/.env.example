# =========================================
# TTS Provider 配置
# =========================================
# 默认 edge 免费方案(无需 API Key,需联网)。
# 设置 TTS_PROVIDER=minimax 并填下面 minimaxi=<key> 可切换到 MiniMax(质量更好)。
# 也可通过命令行覆盖: python scripts/generate_tts.py --provider edge|minimax
#
# 可选值: edge | minimax
# 默认行为: 有 minimaxi=xxx → 用 minimax,否则自动用 edge
TTS_PROVIDER=edge

# =========================================
# MiniMax TTS 凭据(可选,只在用 minimax provider 时需要)
# =========================================
# 获取: https://api.minimaxi.com  → 控制台 → API Keys
# 不填时自动回退到 edge 免费方案
minimaxi=your_api_key_here

# =========================================
# Edge TTS 配置(可选,只在用 edge provider 时生效)
# =========================================
# 中文 voice(默认 zh-CN-XiaoxiaoNeural / 晓晓)。
# 其他推荐:
#   zh-CN-YunxiNeural     云希(男声,通用)
#   zh-CN-YunyangNeural   云扬(男声,新闻/旁白风格,适合数学证明)
#   zh-CN-XiaoyiNeural    晓伊(女声,情感丰富)
# 列出所有可用 voice: python scripts/generate_tts.py --list-voices
EDGE_VOICE=zh-CN-XiaoxiaoNeural
